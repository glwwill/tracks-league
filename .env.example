# Copy this file to .env and fill it in. Never share or upload .env.

# WinHost SQL Server
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# DB_PORT=1433
# DB_ENCRYPT=true

# Long random text used to sign login cookies
JWT_SECRET=

# From Google Cloud Console (see README.md). Leave blank until you have it.
GOOGLE_CLIENT_ID=

# true lets anyone sign in with any email, for testing before Google is set up. Use false when live.
DEV_LOGIN=true

PORT=3001
